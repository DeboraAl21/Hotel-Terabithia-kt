1. Cadastrar
2. Pesquisar
3. Sair
""".trimIndent()
        )

        when (readln().toIntOrNull()) {

            // Cadastrar novo hóspede
            1 -> cadastrarHospede(listaHospedes)

            // Pesquisar por nome
            2 -> pesquisarHospede(listaHospedes)

            // Voltar ao menu principal
            3 -> sairCadastroHospedes()

            else -> println("Por favor, informe um número entre 1 e 3.")
        }
    }
}


// ------------------------------------------------------------
// Adiciona novo hóspede à lista
// ------------------------------------------------------------
fun cadastrarHospede(listaHospedes: MutableList<Hospede>) {

    println("Informe o nome do Hóspede:")
    val nome = readln()

    println("Informe seu Documento de Identidade:")
    val docIdentidade = readln()

    println("Informe seu CPF:")
    val cpf = readln()

    println("Informe a sua data de nascimento (dd/MM/yyyy):")
    val dataNasc = sdf.parse(readln())

    println("Informe a sua Nacionalidade:")
    val nacionalidade = readln()

    val hospede = Hospede(
        nome = nome,
        DocIdentidade = docIdentidade,
        cpf = cpf,
        dataNasc = dataNasc,
        nacionalidade = nacionalidade
    )

    listaHospedes.add(hospede)

    println("Hóspede cadastrado com sucesso!")
}


// ------------------------------------------------------------
// Pesquisa hóspedes por nome (ou parte do nome)
// ------------------------------------------------------------

fun pesquisarHospede(listaHospedes: MutableList<Hospede>) {

    println("Informe o nome para buscar:")
    val busca = readln()

    val resultados = listaHospedes.filter {
        it.nome.contains(busca, ignoreCase = true)
    }

    if (resultados.isEmpty()) {
        println("Nenhum hóspede encontrado.")
    } else {
        resultados.forEach { println(it) }
    }
}


