// ------------------------------------------------------------
// Exibe saudação inicial e solicita o nome do usuário.
// ------------------------------------------------------------
fun apresentacao() {

    println("Olá você está acessando o Hotel Terabithia.\n Informe o seu nome:\n")
    val nome = readln()

//Valida a senha e com um laço de repetição faz com que após 3 tentativas erradas ele bloqueie o acesso.
    while (tentativas >= 0) {

        println("Informe a senha: \n")
        senha = readln().toInt()

        if (senha == 2678) {
            println("Bem-vindo(a) ao Hotel Terabithia, ${nome}. É um imenso prazer ter você por aqui! \n")
            inicio()
            return
        } else {
            tentativas--
            println("A senha está incorreta! Tentativas restantes: $tentativas\n")

            apresentacao()
        }
    }
    println("você errou a senha 3 vezes. Acesso bloqueado!")

}


// ------------------------------------------------------------
// MENU PRINCIPAL DO SISTEMA
// Usuário escolhe o que deseja fazer no hotel.
// ------------------------------------------------------------
fun inicio() {
    println(
        """
O que vamos fazer hoje?:

1 -> Cadastrar Quartos
2 -> Cadastrar Hóspedes
3 -> Reservas de Quartos
4 -> Abastecimento De Automoveis
5 -> Sair Do Hotel
""".trimIndent()
    )

    // Lê a escolha e chama a função correspondente
    when (readln().toIntOrNull()) {
        1 -> cadastrarQuartos()
        2 -> cadastrarHospedes()
        3 -> reservaQuartos()
        4 -> abastecimentoDeAutomoveis()
        5 -> sairDoHotel()
        else -> erro()
    }
}

/* ============================================================
                MENU DE QUARTOS
============================================================ */

fun cadastrarQuartos() {

    // Loop infinito permite que o usuário execute várias ações
    while (true) {
        println(
            """
Cadastro de Quartos
Selecione uma opção:
1. Cadastrar novo quarto
2. Listar quartos
3. Pesquisar quarto
4. Sair
""".trimIndent()
        )

        when (readln().toIntOrNull()) {

            // Adicionar novo quarto
            1 -> cadastrarNovoQuarto()

            // Mostrar todos os quartos já cadastrados
            2 -> listarQuartos()

            // Buscar quarto por número ou tipo
            3 -> pesquisarQuarto()

            // Voltar ao menu principal
            4 -> voltarMenuPrincipal()

            else -> println("Por favor, informe um número entre 1 e 4.")
        }
    }
}


// ------------------------------------------------------------
// Cadastra manualmente um novo quarto no sistema
// ------------------------------------------------------------
fun cadastrarNovoQuarto() {

    println("Informe o número do quarto:")
    val numero = readln()

    println("Informe o tipo (Standard, Executivo ou Luxo):")
    val tipo = readln()

    println("Informe o preço:")
    val preco = readln().toDouble()

    // Adiciona novo quarto na lista global
    quartos.add(Quarto(numero, tipo, preco))

    println("Quarto cadastrado com sucesso!")
}


// ------------------------------------------------------------
// Lista todos os quartos do hotel
// ------------------------------------------------------------
fun listarQuartos() {
    println("Lista de Quartos:")
    quartos.forEach { println(it) }
}


// ------------------------------------------------------------
// Pesquisa um quarto pelo número ou tipo
// ------------------------------------------------------------
fun pesquisarQuarto() {
    println("Informe o número ou tipo para buscar:")
    val busca = readln()

    // Filtra quartos com base no texto informado
    val resultados = quartos.filter {
        it.numero.contains(busca, ignoreCase = true) ||
                it.tipo.contains(busca, ignoreCase = true)
    }

    if (resultados.isEmpty()) println("Nenhum quarto encontrado.")
    else resultados.forEach { println(it) }
}


