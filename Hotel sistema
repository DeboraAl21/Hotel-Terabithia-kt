fun abastecimentoDeAutomoveis() {
    println("Função ainda não implementada.")
}


// ------------------------------------------------------------
// Tratamento de erro do menu principal
// ------------------------------------------------------------
fun erro() {
    println("Por favor, informe um número entre 1 e 4.")
    inicio()
}


// ------------------------------------------------------------
// Finaliza o programa
// ------------------------------------------------------------
fun sairDoHotel() {
    println("Você deseja sair? S/N")

    if (readln().uppercase() == "S") {
        println("Até logo!")
        exitProcess(0)
    } else inicio()
}

