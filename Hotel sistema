// Reservas de Quartos
// ------------------------------------------------------------
fun reservaQuartos(){
        println("--- Reserva de Quartos ---")

        // 1. Localizar o Hóspede
        println("Informe o nome do hóspede para a reserva:")
        val nomeBusca = readln()
        val hospede = listaHospedes.find { it.nome.contains(nomeBusca, ignoreCase = true) }

        if (hospede == null) {
            println("Hóspede não encontrado! Cadastre-o primeiro.")
            return inicio()
        }

        // 2. Localizar o Quarto
        println("Informe o número do quarto desejado:")
        val numQuarto = readln()
        val quarto = quartos.find { it.numero == numQuarto }

        if (quarto == null) {
            println("Quarto não encontrado!")
            return inicio()
        }

        // 3. Definir tempo de estadia
        println("Quantos dias de reserva?")
        val dias = readln().toIntOrNull() ?: 0

        if (dias <= 0) {
            println("Quantidade de dias inválida.")
            return inicio()
        }

        // 4. Calcular e Confirmar
        val valorTotal = quarto.preco * dias
        println("Resumo da Reserva:")
        println("Hóspede: ${hospede.nome}")
        println("Quarto: ${quarto.numero} (${quarto.tipo})")
        println("Total: R$ $valorTotal")

        println("Confirmar reserva? (S/N)")
        if (readln().uppercase() == "S") {
            val novaReserva = Reserva(hospede, quarto, dias, valorTotal)
            listaReservas.add(novaReserva)
            println("Reserva realizada com sucesso!")
        } else {
            println("Reserva cancelada.")
        }

        inicio() // Volta ao menu principal
    }

